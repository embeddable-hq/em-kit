{
  "name": "em-kit",
  "version": "0.0.0",
  "description": "EmKit by Embeddable: finished React chart, KPI and table components for teams that already have a data layer.",
  "keywords": [
    "react",
    "charts",
    "chart.js",
    "dashboard",
    "kpi",
    "table",
    "data visualization",
    "customer-facing analytics",
    "embedded analytics",
    "multi-tenant",
    "embeddable"
  ],
  "homepage": "https://emkit.embeddable.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embeddable-hq/em-kit.git"
  },
  "bugs": "https://github.com/embeddable-hq/em-kit/issues",
  "author": "Embeddable (https://embeddable.com)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "sync": "node scripts/sync.mjs && node scripts/exports.mjs && node scripts/props.mjs",
    "exports": "node scripts/exports.mjs",
    "types:check": "tsc --noEmit",
    "dev": "vite",
    "site:build": "node scripts/site-build.mjs",
    "site:check": "node scripts/site-build.mjs --check",
    "site:preview": "node scripts/site-preview.mjs",
    "audit": "node scripts/audit.mjs",
    "size": "node scripts/size.mjs",
    "check": "npm run sync && npm run types:check && npm run test && npm run site:check",
    "test": "vitest run",
    "field-inputs": "node scripts/extract-field-inputs.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.34.1",
    "auto-text-size": "^0.2.3",
    "chart.js": "^4.5.0",
    "chartjs-chart-funnel": "^4.2.5",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chroma-js": "^3.1.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.14",
    "dom-to-image-more": "^3.6.3",
    "fast-equals": "^6.0.0",
    "i18next": "^25.3.2",
    "mergician": "^2.0.2",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^9.12.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "peerDependencies": {
    "react": ">=19.1.1",
    "react-dom": ">=19.1.1"
  },
  "devDependencies": {
    "@types/chroma-js": "^3.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sugar-high": "^2.4.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
